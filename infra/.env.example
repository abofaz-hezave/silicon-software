# Export these in your shell before running infra scripts. Never commit real values.
# Required. Target AWS region (provider region).
AWS_REGION=
# Required. Value for the `owner` cost-allocation tag.
OWNER=
# Optional for non-production stages. Route 53 hosted zone name and the site domain
# inside it. Set both or neither; without them the site uses its default CloudFront URL.
# Production requires both.
HOSTED_ZONE_NAME=
DOMAIN_NAME=
# Optional. SNS topic ARN that receives CloudWatch alarm notifications.
ALARM_TOPIC_ARN=
# Used by `pnpm --filter @repo/infra diff|deploy|remove`. Required, e.g. dev-yourname.
STAGE=
